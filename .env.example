# Copy to .env.local and fill in. Never commit .env.local.

# ---- Supabase (Project Settings → API) ----
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Server only. Never expose to the browser.
SUPABASE_SERVICE_ROLE_KEY=

# ---- Postgres (Connect → Direct → Session pooler, port 5432) ----
DATABASE_URL=

# ---- App ----
NEXT_PUBLIC_APP_URL=http://localhost:3000
NEXT_PUBLIC_SUPPORT_EMAIL=

# ---- Web push: generate with `npx web-push generate-vapid-keys` ----
NEXT_PUBLIC_VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=https://your-app.vercel.app

# ---- Cron: any long random string; Vercel sends it as a Bearer token ----
CRON_SECRET=
